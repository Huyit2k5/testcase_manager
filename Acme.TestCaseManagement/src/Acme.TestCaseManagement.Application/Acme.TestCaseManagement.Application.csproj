<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Acme.TestCaseManagement</RootNamespace>
    <Description>Application services of the Acme.TestCaseManagement ABP module: test library, plans, runs and executions, requirements, RTM, quality gates and sign-off, Excel and CSV import and export.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Ddd.Application" />
    <PackageReference Include="Volo.Abp.AutoMapper" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="PDFsharp-MigraDoc" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <InternalsVisibleTo Include="Acme.TestCaseManagement.Application.Tests" />
    <ProjectReference Include="..\Acme.TestCaseManagement.Domain\Acme.TestCaseManagement.Domain.csproj" />
    <ProjectReference Include="..\Acme.TestCaseManagement.Application.Contracts\Acme.TestCaseManagement.Application.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Noto Sans (SIL Open Font License, see Reports/Fonts/OFL.txt), cut down to Latin and Vietnamese: the PDF of a report needs a font that has the letters of the language. -->
    <EmbeddedResource Include="Reports\Fonts\*.ttf" />
  </ItemGroup>
</Project>
